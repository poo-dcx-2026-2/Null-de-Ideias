@startuml

skinparam classAttributeIconSize 0
hide empty members

title Diagrama de Classes - Sistema de Biblioteca


' =========================================================
' ENUM
' =========================================================

enum StatusExemplar {
    DISPONIVEL
    EMPRESTADO
    RESERVADO
    INDISPONIVEL
}


' =========================================================
' CLASSES DE DOMÍNIO
' =========================================================

class Item {
    - codigo : String {readOnly}
    - titulo : String
    - autoria : String
    - categoria : String
    - ano : int
    - exemplares : List<Exemplar>

    + Item(codigo : String, titulo : String, autoria : String, categoria : String, ano : int)

    + getCodigo() : String

    + getTitulo() : String
    + setTitulo(titulo : String) : void

    + getAutoria() : String
    + setAutoria(autoria : String) : void

    + getCategoria() : String
    + setCategoria(categoria : String) : void

    + getAno() : int
    + setAno(ano : int) : void

    + getExemplares() : List<Exemplar>
    + adicionarExemplar(exemplar : Exemplar) : void
}


class Exemplar {
    - tombo : String {readOnly}
    - item : Item {readOnly}
    - status : StatusExemplar

    + Exemplar(tombo : String, item : Item)

    + getTombo() : String
    + getItem() : Item

    + getStatus() : StatusExemplar
    + setStatus(status : StatusExemplar) : void
}


class Usuario {
    - matricula : String {readOnly}
    - nome : String
    - ativo : boolean
    - emprestimosAtivos : int

    + Usuario(matricula : String, nome : String)

    + getMatricula() : String

    + getNome() : String
    + setNome(nome : String) : void

    + isAtivo() : boolean
    + setAtivo(ativo : boolean) : void

    + getEmprestimosAtivos() : int
    + incrementEmprestimosAtivos() : void
    + decrementEmprestimosAtivos() : void
}


' =========================================================
' CLASSE PRINCIPAL
' =========================================================

class BibliotecaInicial {
    - acervo : AcervoEmMemoria
    - usuarios : UsuariosEmMemoria
    - emprestimos : EmprestimosNaoImplementados
    - relatorios : RelatoriosNaoImplementados

    + acervo() : AcervoService
    + usuarios() : UsuarioService
    + emprestimos() : EmprestimoService
    + relatorios() : RelatorioService

    + salvar() : void
    + carregar() : void
}


' =========================================================
' SERVIÇO DE ACERVO
' =========================================================

class AcervoEmMemoria {
    - itens : Map<String, Item>

    + cadastrarItem(codigo : String, titulo : String, autoria : String, categoria : String, ano : int) : void
    + buscarItem(codigo : String) : ItemView
    + listarItens() : List<ItemView>
    + buscarPorTitulo(trecho : String) : List<ItemView>
    + buscarPorCategoria(categoria : String) : List<ItemView>
    + adicionarExemplar(codigoDoItem : String, tombo : String) : void
    + listarExemplares(codigoDoItem : String) : List<ExemplarView>
    + baixarExemplar(tombo : String) : void

    - localizar(codigo : String) : Item
    - paraView(item : Item) : ItemView
    - exigirTextoPreenchido(valor : String, campo : String) : void
}


' =========================================================
' SERVIÇO DE USUÁRIOS
' =========================================================

class UsuariosEmMemoria {
    - usuarios : Map<String, Usuario>

    + cadastrarUsuario(matricula : String, nome : String) : void
    + buscarUsuario(matricula : String) : UsuarioView
    + listarUsuarios() : List<UsuarioView>
    + desativarUsuario(matricula : String) : void
    + reativarUsuario(matricula : String) : void
}


' =========================================================
' SERVIÇO DE EMPRÉSTIMOS
' =========================================================

class EmprestimosNaoImplementados {

    + emprestar(tombo : String, matricula : String, data : LocalDate) : String
    + devolver(tombo : String, data : LocalDate) : void
    + listarEmprestimosDoUsuario(matricula : String) : List<EmprestimoView>
    + listarAtrasados(data : LocalDate) : List<EmprestimoView>
    + reservar(codigoDoItem : String, matricula : String, data : LocalDate) : String
    + listarReservas(codigoDoItem : String) : List<ReservaView>
    + cancelarReserva(idDaReserva : String) : void
}


' =========================================================
' SERVIÇO DE RELATÓRIOS
' =========================================================

class RelatoriosNaoImplementados {

    + itensMaisEmprestados(n : int) : List<ItemView>
    + emprestimosPorCategoria() : Map<String, Long>
    + usuariosComAtraso(data : LocalDate) : List<UsuarioView>
    + taxaDeOcupacaoDoAcervo() : double
    + importarItensEmLote(arquivo : Path) : int
}


' =========================================================
' INTERFACES / CONTRATOS
' =========================================================

interface Biblioteca {
    + acervo() : AcervoService
    + usuarios() : UsuarioService
    + emprestimos() : EmprestimoService
    + relatorios() : RelatorioService
    + salvar() : void
    + carregar() : void
}


interface AcervoService {
    + cadastrarItem(codigo : String, titulo : String, autoria : String, categoria : String, ano : int) : void
    + buscarItem(codigo : String) : ItemView
    + listarItens() : List<ItemView>
    + buscarPorTitulo(trecho : String) : List<ItemView>
    + buscarPorCategoria(categoria : String) : List<ItemView>
    + adicionarExemplar(codigoDoItem : String, tombo : String) : void
    + listarExemplares(codigoDoItem : String) : List<ExemplarView>
    + baixarExemplar(tombo : String) : void
}


interface UsuarioService {
    + cadastrarUsuario(matricula : String, nome : String) : void
    + buscarUsuario(matricula : String) : UsuarioView
    + listarUsuarios() : List<UsuarioView>
    + desativarUsuario(matricula : String) : void
    + reativarUsuario(matricula : String) : void
}


interface EmprestimoService {
    + emprestar(tombo : String, matricula : String, data : LocalDate) : String
    + devolver(tombo : String, data : LocalDate) : void
    + listarEmprestimosDoUsuario(matricula : String) : List<EmprestimoView>
    + listarAtrasados(data : LocalDate) : List<EmprestimoView>
    + reservar(codigoDoItem : String, matricula : String, data : LocalDate) : String
    + listarReservas(codigoDoItem : String) : List<ReservaView>
    + cancelarReserva(idDaReserva : String) : void
}


interface RelatorioService {
    + itensMaisEmprestados(n : int) : List<ItemView>
    + emprestimosPorCategoria() : Map<String, Long>
    + usuariosComAtraso(data : LocalDate) : List<UsuarioView>
    + taxaDeOcupacaoDoAcervo() : double
    + importarItensEmLote(arquivo : Path) : int
}


' =========================================================
' CLASSES VIEW
' =========================================================

class ItemView {
}

class ExemplarView {
}

class UsuarioView {
}

class EmprestimoView {
}

class ReservaView {
}


' =========================================================
' RELACIONAMENTOS DE HERANÇA / IMPLEMENTAÇÃO
' =========================================================

BibliotecaInicial ..|> Biblioteca
AcervoEmMemoria ..|> AcervoService
UsuariosEmMemoria ..|> UsuarioService
EmprestimosNaoImplementados ..|> EmprestimoService
RelatoriosNaoImplementados ..|> RelatorioService


' =========================================================
' RELACIONAMENTOS DO DOMÍNIO
' =========================================================

Item "1" *-- "0..*" Exemplar : possui
Exemplar --> Item : pertence a
Exemplar --> StatusExemplar : possui estado


' =========================================================
' RELACIONAMENTOS DA BIBLIOTECA
' =========================================================

BibliotecaInicial *-- AcervoEmMemoria : possui
BibliotecaInicial *-- UsuariosEmMemoria : possui
BibliotecaInicial *-- EmprestimosNaoImplementados : possui
BibliotecaInicial *-- RelatoriosNaoImplementados : possui


' =========================================================
' RELACIONAMENTOS DOS SERVIÇOS
' =========================================================

AcervoEmMemoria "1" *-- "0..*" Item : gerencia (por código)
AcervoEmMemoria --> ItemView : cria
AcervoEmMemoria --> ExemplarView : cria

UsuariosEmMemoria "1" *-- "0..*" Usuario : gerencia (por matrícula)
UsuariosEmMemoria --> UsuarioView : cria

RelatoriosNaoImplementados --> ItemView : utiliza
RelatoriosNaoImplementados --> UsuarioView : utiliza
RelatoriosNaoImplementados --> EmprestimoView : utiliza

EmprestimosNaoImplementados --> EmprestimoView : utiliza
EmprestimosNaoImplementados --> ReservaView : utiliza


' =========================================================
' BIBLIOTECA E SEUS CONTRATOS
' =========================================================

BibliotecaInicial ..> AcervoService : utiliza
BibliotecaInicial ..> UsuarioService : utiliza
BibliotecaInicial ..> EmprestimoService : utiliza
BibliotecaInicial ..> RelatorioService : utiliza


@enduml